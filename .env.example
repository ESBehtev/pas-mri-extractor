# Manual local vLLM default inside this container.
# MODEL_PATH may point to a mounted Hugging Face AWQ/GPTQ model directory.
MODEL_PATH=/models
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.9

PAS_API_BASE_URL=http://127.0.0.1:8000/v1
PAS_API_KEY=local-token
PAS_MODEL=local-model
PAS_TIMEOUT=60
PAS_TEMPERATURE=0.0
PAS_MAX_TOKENS=2048
