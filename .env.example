# Local vLLM model server. Change VLLM_MODEL to switch Qwen, Llama or Mistral.
HF_TOKEN=
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=8192

PAS_API_BASE_URL=http://vllm:8000/v1
PAS_API_KEY=local-token
PAS_MODEL=${VLLM_MODEL}
PAS_TIMEOUT=60
PAS_TEMPERATURE=0.0
PAS_MAX_TOKENS=2048
